# ==============================================================================
# REXION AI PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Note: Keep this file safe to commit. Never place production credentials here.
# ==============================================================================

# Node Environment & Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://app.rexion.ai
BACKEND_PUBLIC_URL=https://api.rexion.ai

# Authentication & Encryption (Min 32 random characters for production)
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_min_32_chars
JWT_EXPIRE=7d
# Base64 32-byte key for AES-256-GCM token encryption:
# Generated via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=replace_with_base64_encoded_32_byte_key

# Databases & Infrastructure
# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/rexion?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/rexion?retryWrites=true&w=majority
MONGO_MAX_POOL=20
MONGO_MIN_POOL=5

# Redis (Managed / Upstash / Redis Cloud / Local)
REDIS_URL=redis://default:<password>@<redis-host>:6379

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://ml-service:8000
USE_FALLBACK_ANALYSIS=true

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5-5

# LinkedIn App & Autonomous Social Agent
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://api.rexion.ai/api/li-agent/callback
LINKEDIN_API_VERSION=202608

# Stripe Billing & Subscriptions
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
STRIPE_PRO_PRICE_ID=price_pro_monthly
STRIPE_ELITE_PRICE_ID=price_elite_monthly
STRIPE_PRO_ANNUAL_PRICE_ID=price_pro_annual
STRIPE_ELITE_ANNUAL_PRICE_ID=price_elite_annual

# Email Dispatcher & Verification Relay
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=team@rexion.ai

# Observability & Monitoring
LANGFUSE_SECRET_KEY=sk-lf-replace-with-langfuse-secret
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-langfuse-public
LANGFUSE_BASE_URL=https://cloud.langfuse.com
METRICS_SECRET=replace_with_internal_metrics_secret_header
