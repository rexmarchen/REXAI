 "referenceSolution": {
  "python": "def lengthOfLongestSubstring(s):\n    last = {}; start = best = 0\n    for i, c in enumerate(s):\n        if c in last and last[c] >= start: start = last[c] + 1\n        last[c] = i; best = max(best, i - start + 1)\n    return best\n"
 },
