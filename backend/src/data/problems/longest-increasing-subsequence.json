 },
 "referenceSolution": {
  "python": "def lengthOfLIS(nums):\n    from bisect import bisect_left\n    t = []\n    for x in nums:\n        i = bisect_left(t, x)\n        if i == len(t): t.append(x)\n        else: t[i] = x\n    return len(t)\n"
 },
