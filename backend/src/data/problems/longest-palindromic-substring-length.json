 "referenceSolution": {
  "python": "def longestPalindromeLength(s):\n    best = 0\n    for c in range(len(s)):\n        for l, r in ((c, c), (c, c + 1)):\n            while l >= 0 and r < len(s) and s[l] == s[r]: l -= 1; r += 1\n            best = max(best, r - l - 1)\n    return best\n"
 },
