# Keep this file safe to commit. Put real values only in backend/.env.
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret

# LinkedIn account connection flow (/connect/*)
DATABASE_URL=postgres://user:password@localhost:5432/rexion
SESSION_SECRET=replace_with_a_long_random_session_secret
ENCRYPTION_KEY=replace_with_64_character_hex_string
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:5000/connect/auth/linkedin/callback
LINKEDIN_VERSION=202405

# Multi-user LinkedIn automation agent
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_TICK_CRON=*/1 * * * *
AUTOMATION_VECTOR_ROOT=data/vector-index
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GITHUB_TOKEN=optional_app_level_github_token_for_higher_rate_limits
LINKEDIN_VERSION=202405

# Multi-user LinkedIn automation agent
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_TICK_CRON=*/1 * * * *
AUTOMATION_VECTOR_ROOT=data/vector-index
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GITHUB_TOKEN=optional_app_level_github_token_for_higher_rate_limits

# Contact discovery (server-side only)
APOLLO_API_KEY=your_apollo_api_key_here

# Outbound email relay. Configure SPF, DKIM and DMARC before sending campaigns.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=outreach@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=outreach@example.com
EMAIL_REPLY_TO=you@example.com
OUTREACH_PHYSICAL_ADDRESS=123 Example Street, Your City, Country
OUTREACH_ENCRYPTION_KEY=replace_with_64_character_hex_string
OUTREACH_STATE_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common

# Optional services
MONGO_URI=mongodb://127.0.0.1:27017/rexion
REDIS_URL=redis://127.0.0.1:6379
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku
