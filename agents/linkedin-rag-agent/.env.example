# =================================================================
# REXION LinkedIn RAG Agent Configuration
# =================================================================

# 1. Google Gemini AI (Required)
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. LinkedIn Integration (Required for live posting)
# OAuth Access Token with `w_member_social` permission
LINKEDIN_ACCESS_TOKEN=your_linkedin_oauth_access_token

# Optional: Person URN (e.g. urn:li:person:abcdef). If left blank,
# the agent automatically resolves it from your access token via /v2/userinfo
LINKEDIN_PERSON_URN=

# 3. Personalization & Research (Optional)
AUTHOR_NAME=Anshu Pal
GITHUB_USERNAME=rexmarchen
GITHUB_TOKEN=

# 4. Storage & Cloud Memory (Optional)
# If left blank, agent uses local vector-store.json and memories.json files
MONGODB_URI=
MONGODB_DB_NAME=rexion_automation

# 5. Model Overrides (Optional)
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
