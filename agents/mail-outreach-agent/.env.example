# --- Server ---
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
ENCRYPTION_KEY=replace_with_32_byte_hex_key_generated_via_crypto_randomBytes

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/outreach_agent

# --- Redis (BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- Google OAuth (Gmail API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Scope requested is gmail.send + gmail.readonly (readonly is needed only for
# bounce/reply polling; drop it if you don't want to request that scope).

# --- Microsoft OAuth (Graph API) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# --- Sending defaults (per-mailbox soft caps, overridable per mailbox row) ---
DEFAULT_DAILY_CAP_NEW_MAILBOX=20
DEFAULT_DAILY_CAP_WARMED_MAILBOX=150
WARMUP_RAMP_DAYS=21
MIN_SEND_INTERVAL_MS=45000
MAX_SEND_JITTER_MS=90000

# --- Deliverability guardrails ---
BOUNCE_RATE_PAUSE_THRESHOLD=0.05
COMPLAINT_RATE_PAUSE_THRESHOLD=0.001

# --- Email verification (optional third-party API, e.g. NeverBounce/ZeroBounce) ---
EMAIL_VERIFICATION_API_KEY=
EMAIL_VERIFICATION_API_URL=

# --- Apollo Lead Sourcing (Optional) ---
APOLLO_API_KEY=

