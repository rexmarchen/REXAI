{
  "name": "mail-outreach-agent",
  "version": "1.0.0",
  "description": "Production outreach agent that sends cold email through a user's own Gmail/Outlook mailbox via OAuth, with a queue, rate limiter, bounce/reply detection and suppression list.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "worker:send": "tsx src/queue/sendWorker.ts",
    "worker:token-refresh": "tsx src/queue/tokenRefreshWorker.ts",
    "worker:polling": "tsx src/polling/pollWorker.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@azure/msal-node": "^2.13.1",
    "googleapis": "^144.0.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "dotenv": "^16.4.5",
    "mailparser": "^3.7.1",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "typescript": "^5.6.2",
    "tsx": "^4.19.1",
    "prisma": "^5.20.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.5",
    "vitest": "^2.1.1"
  }
}
