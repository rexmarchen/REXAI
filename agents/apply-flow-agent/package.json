{
  "name": "apply-flow-service",
  "version": "1.0.0",
  "description": "Resume parsing, matching, and notification API service",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/structured-autofill.test.js",
    "test:meridian": "node test-agent-fill-live.js --form benchmarks/meridian-greenhouse.html --visible",
    "test:fernwood": "node test-agent-fill-live.js --form benchmarks/fernwood-lever.html --visible",
    "test:cascade": "node test-agent-fill-live.js --form benchmarks/cascade-workday-multistep.html --visible",
    "train:langfuse": "node train-and-eval-langfuse.js"
  },
  "dependencies": {
    "@langfuse/openai": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "groq-sdk": "^0.13.0",
    "helmet": "^8.3.0",
    "langfuse": "^3.39.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^22.12.1",
    "resend": "^4.1.2"
  }
